{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "installCommand": "cd frontend && npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gotot-app.onrender.com/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://gotot-app.onrender.com/ws/:path*"
    }
  ]
}
